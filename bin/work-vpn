#!/usr/bin/env bash
# work-vpn — helper del widget Work connection.
#
# El widget es sólo la UI: esto resuelve la VPN (por defecto con NetworkManager,
# que ya sabe de OpenVPN, WireGuard, Fortinet, StrongSwan…) y abre las apps de
# trabajo que tengas instaladas. Nada de credenciales acá: las maneja el backend.
#
#   work-vpn status [--json]   estado: conexión, IP del túnel, gateway
#   work-vpn up | down | toggle
#   work-vpn list              conexiones VPN que conoce NetworkManager
#   work-vpn apps [--json]     apps de trabajo instaladas (para los botones)
#   work-vpn open <id>         abre una de esas apps
#
# Alias viejos, para no romper a nadie: --status, --vpn-only, --down, --rdp,
# --teams.
#
# Config (opcional): ~/.config/work-vpn/config
#   connection=<nombre en NetworkManager>   (si no, la primera VPN activa)
#   apps=slack,teams,discord,signal         (si no, todas las que detecte)

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/work-vpn"
CONFIG_FILE="$CONFIG_DIR/config"

die() {
    printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

# --- configuración -----------------------------------------------------------
CONNECTION="${WORK_VPN_CONNECTION:-}"
APPS_FILTER="${WORK_VPN_APPS:-}"
if [[ -r $CONFIG_FILE ]]; then
    while IFS='=' read -r key value; do
        case $key in
            connection) CONNECTION="${CONNECTION:-$value}" ;;
            apps) APPS_FILTER="${APPS_FILTER:-$value}" ;;
        esac
    done <"$CONFIG_FILE"
fi

# --- backend: NetworkManager -------------------------------------------------
nm() { command nmcli "$@"; }

# Conexiones VPN conocidas (vpn = openvpn/fortinet/strongswan…, wireguard aparte).
vpn_connections() {
    nm -t -f NAME,TYPE connection show 2>/dev/null |
        awk -F: '$2 == "vpn" || $2 == "wireguard" { print $1 }'
}

active_vpn() {
    local name
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        if nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
            printf '%s' "$name"
            return 0
        fi
    done < <(vpn_connections)
    return 1
}

resolve_connection() {
    if [[ -n $CONNECTION ]]; then
        printf '%s' "$CONNECTION"
        return 0
    fi
    active_vpn && return 0
    vpn_connections | head -1
}

tunnel_ip() { # tunnel_ip <connection>
    local name=$1 dev
    dev=$(nm -t -f GENERAL.DEVICES connection show "$name" 2>/dev/null | head -1 | cut -d: -f2-)
    [[ -n $dev ]] || return 1
    nm -t -f IP4.ADDRESS device show "$dev" 2>/dev/null | head -1 | cut -d: -f2 | cut -d/ -f1
}

tunnel_gateway() {
    local name=$1 dev
    dev=$(nm -t -f GENERAL.DEVICES connection show "$name" 2>/dev/null | head -1 | cut -d: -f2-)
    [[ -n $dev ]] || return 1
    nm -t -f IP4.GATEWAY device show "$dev" 2>/dev/null | head -1 | cut -d: -f2
}

notify() {
    have notify-send || return 0
    [[ ${WORK_VPN_NOTIFY:-1} == 0 ]] && return 0
    notify-send --app-name="Work connection" --icon=network-vpn "$@" 2>/dev/null || true
}

# --- apps de trabajo ---------------------------------------------------------
# Se detectan por binario o por .desktop; el orden manda en el popup.
# id:etiqueta:binario:archivo .desktop:icono
KNOWN_APPS=(
    "teams:Microsoft Teams:teams-for-linux:teams-for-linux.desktop:󰊻"
    "slack:Slack:slack:slack.desktop:󰒱"
    "discord:Discord:discord:discord.desktop:󰙯"
    "signal:Signal:signal-desktop:signal.desktop:󰭹"
    "remmina:Escritorio remoto:remmina:org.remmina.Remmina.desktop:󰆍"
)

app_field() { # app_field <id> <n>
    local entry
    for entry in "${KNOWN_APPS[@]}"; do
        [[ ${entry%%:*} == "$1" ]] || continue
        printf '%s' "$entry" | cut -d: -f"$2"
        return 0
    done
    return 1
}

desktop_file() { # desktop_file <archivo .desktop>
    local f
    for f in "$HOME/.local/share/applications/$1" "/usr/share/applications/$1" \
        "/var/lib/flatpak/exports/share/applications/$1"; do
        [[ -r $f ]] && {
            printf '%s' "$f"
            return 0
        }
    done
    return 1
}

app_available() { # app_available <id>
    local bin desktop
    bin=$(app_field "$1" 3)
    [[ -n $bin ]] || return 1
    if [[ $bin == /* ]]; then
        [[ -x $bin ]]
        return
    fi
    have "$bin" && return 0
    desktop=$(app_field "$1" 4)
    [[ -n $desktop ]] && desktop_file "$desktop" >/dev/null
}

app_launch() { # app_launch <id>
    local bin desktop file
    bin=$(app_field "$1" 3)
    desktop=$(app_field "$1" 4)
    if have "$bin"; then
        setsid nohup "$bin" >/dev/null 2>&1 &
        return 0
    fi
    if [[ -n $desktop ]] && file=$(desktop_file "$desktop"); then
        if have gtk-launch; then
            gtk-launch "$(basename "$file" .desktop)" >/dev/null 2>&1 &
            return 0
        fi
        if have gio; then
            gio launch "$file" >/dev/null 2>&1 &
            return 0
        fi
    fi
    return 1
}

app_ids() {
    local id
    for entry in "${KNOWN_APPS[@]}"; do
        id=${entry%%:*}
        app_available "$id" || continue
        if [[ -n $APPS_FILTER ]]; then
            case ",$APPS_FILTER," in
                *",$id,"*) ;;
                *) continue ;;
            esac
        fi
        printf '%s\n' "$id"
    done
}

app_open() { # app_open <id>
    local id=$1 bin desktop
    app_available "$id" || die "No tenés '$id' instalado"
    bin=$(app_field "$id" 3)
    desktop=$(app_field "$id" 4)
    app_launch "$id" || die "No pude abrir '$id'"
}

# --- salida ------------------------------------------------------------------
need_jq() { have jq || die "Falta jq (pacman -S jq)"; }

print_status_json() {
    need_jq
    local name connected="false" ip="" gw="" detail=""
    if name=$(resolve_connection) && [[ -n $name ]]; then
        if nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
            connected="true"
            ip=$(tunnel_ip "$name" || true)
            gw=$(tunnel_gateway "$name" || true)
            detail="Conectada"
        else
            detail="Desconectada"
        fi
    else
        detail="Sin conexiones VPN en NetworkManager"
    fi
    jq -nc --arg backend "nmcli" --argjson connected "$connected" \
        --arg name "${name:-}" --arg ip "$ip" --arg gateway "$gw" --arg detail "$detail" \
        '{backend: $backend, connected: $connected, connection: $name, ip: $ip, gateway: $gateway, detail: $detail}'
}

print_status_text() {
    local name
    if name=$(resolve_connection) && [[ -n $name ]] &&
        nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
        printf 'VPN conectada (%s)\n' "$name"
        local ip gw
        ip=$(tunnel_ip "$name" || true)
        gw=$(tunnel_gateway "$name" || true)
        [[ -n $ip ]] && printf 'IP %s\n' "$ip"
        [[ -n $gw ]] && printf 'via %s\n' "$gw"
    else
        printf 'VPN desconectada\n'
    fi
}

print_apps_json() {
    need_jq
    local id label icon args
    {
        for id in $(app_ids); do
            label=$(app_field "$id" 2)
            icon=$(app_field "$id" 5)
            jq -nc --arg id "$id" --arg label "$label" --arg icon "$icon" \
                '{id: $id, label: $label, icon: $icon}'
        done
    } | jq -sc '.'
}

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

# --- comandos ----------------------------------------------------------------
cmd=${1:-status}
shift || true
case $cmd in
    status | --status)
        if [[ ${1:-} == --json ]]; then print_status_json; else print_status_text; fi
        ;;
    up | connect | --vpn-only)
        name=$(resolve_connection) || die "No encontré ninguna conexión VPN en NetworkManager (mirá 'work-vpn list')"
        nm connection up "$name" >/dev/null 2>&1 || die "No pude levantar '$name'"
        notify "VPN conectada" "${name}"
        printf 'VPN conectada (%s)\n' "$name"
        ;;
    down | disconnect)
        name=$(resolve_connection) || die "No encontré ninguna conexión VPN"
        nm connection down "$name" >/dev/null 2>&1 || die "No pude bajar '$name'"
        notify "VPN desconectada" "$name"
        printf 'VPN desconectada (%s)\n' "$name"
        ;;
    toggle)
        if name=$(active_vpn); then
            exec "$0" down
        fi
        exec "$0" up
        ;;
    list)
        vpn_connections
        ;;
    apps)
        if [[ ${1:-} == --json ]]; then print_apps_json; else app_ids; fi
        ;;
    open)
        [[ -n ${1:-} ]] || die "Decime qué app: work-vpn open <id>"
        app_open "$1"
        ;;
    --rdp) app_open remmina ;;
    --teams) app_open teams ;;
    -h | --help | help) usage ;;
    *) die "No conozco '$cmd' (probá: work-vpn --help)" ;;
esac
