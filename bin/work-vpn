#!/usr/bin/env bash
# work-vpn — helper del widget Work connection.
#
# El widget es sólo la UI: esto resuelve la VPN (por defecto con NetworkManager,
# que ya sabe de OpenVPN, WireGuard, Fortinet, StrongSwan…) y abre las apps de
# trabajo que tengas instaladas. Nada de credenciales acá: las maneja el backend.
#
#   work-vpn status [--json]   estado: conexión, IP del túnel, gateway
#   work-vpn up | down | toggle
#   work-vpn list              conexiones VPN que conoce NetworkManager
#   work-vpn apps [--json]     apps de trabajo instaladas (para los botones)
#   work-vpn open <id>         abre una de esas apps
#   work-vpn lang [en|es]      idioma del widget (sin argumento, lo muestra)
#
# Alias viejos, para no romper a nadie: --status, --vpn-only, --down, --rdp,
# --teams.
#
# Config (opcional): ~/.config/work-vpn/config
#   connection=<nombre en NetworkManager>   (si no, la primera VPN activa)
#   apps=slack,teams,discord,signal         (si no, todas las que detecte)

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/work-vpn"
CONFIG_FILE="$CONFIG_DIR/config"
LANG_FILE="$CONFIG_DIR/lang"

die() {
    printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

# --- idioma ------------------------------------------------------------------
# El idioma del widget y del helper (en | es) vive en ~/.config/work-vpn/lang:
# una línea, la misma que lee el panel. Sin archivo, inglés, que es el idioma en
# el que se publica el plugin; el botoncito del encabezado del popup escribe
# este archivo, y esto es lo mismo desde la terminal.
LANG_CODE=$(cat "$LANG_FILE" 2>/dev/null || true)
[[ $LANG_CODE == es ]] || LANG_CODE=en

declare -A MSG_EN=(
    [connected]='Connected'
    [disconnected]='Disconnected'
    [no-connections]='No VPN connections in NetworkManager'
    [vpn-on]='VPN connected'
    [vpn-off]='VPN disconnected'
    [vpn-up]='VPN connected (%s)'
    [vpn-down]='VPN disconnected (%s)'
    [app-teams]='Microsoft Teams'
    [app-slack]='Slack'
    [app-discord]='Discord'
    [app-signal]='Signal'
    [app-remmina]='Remote desktop'
    [lang-set]='Widget language: %s'
    [lang-usage]="lang: use 'en' or 'es'"
    [no-vpn]='I found no VPN connection'
    [no-vpn-nm]="I found no VPN connection in NetworkManager (try 'work-vpn list')"
    [up-failed]="I could not bring up '%s'"
    [down-failed]="I could not bring down '%s'"
    [app-missing]="'%s' is not installed"
    [app-failed]="I could not open '%s'"
    [app-which]='Tell me which app: work-vpn open <id>'
    [no-jq]='jq is missing: the helper needs it to answer the status as JSON'
    [unknown-cmd]="I don't know '%s' (try: work-vpn --help)"
)
declare -A MSG_ES=(
    [connected]='Conectada'
    [disconnected]='Desconectada'
    [no-connections]='Sin conexiones VPN en NetworkManager'
    [vpn-on]='VPN conectada'
    [vpn-off]='VPN desconectada'
    [vpn-up]='VPN conectada (%s)'
    [vpn-down]='VPN desconectada (%s)'
    [app-teams]='Microsoft Teams'
    [app-slack]='Slack'
    [app-discord]='Discord'
    [app-signal]='Signal'
    [app-remmina]='Escritorio remoto'
    [lang-set]='Idioma del widget: %s'
    [lang-usage]="lang: usá 'en' o 'es'"
    [no-vpn]='No encontré ninguna conexión VPN'
    [no-vpn-nm]="No encontré ninguna conexión VPN en NetworkManager (mirá 'work-vpn list')"
    [up-failed]="No pude levantar '%s'"
    [down-failed]="No pude bajar '%s'"
    [app-missing]="No tenés '%s' instalado"
    [app-failed]="No pude abrir '%s'"
    [app-which]='Decime qué app: work-vpn open <id>'
    [no-jq]='Falta jq: el helper lo usa para responder el estado en json'
    [unknown-cmd]="No conozco '%s' (probá: work-vpn --help)"
)

msg() { # msg <clave> [argumentos de printf] — texto de la interfaz, y con salto
    local key=$1
    shift
    local -n table="MSG_${LANG_CODE^^}"
    printf "${table[$key]:-$key}\n" "$@"
}

# --- configuración -----------------------------------------------------------
CONNECTION="${WORK_VPN_CONNECTION:-}"
APPS_FILTER="${WORK_VPN_APPS:-}"
if [[ -r $CONFIG_FILE ]]; then
    while IFS='=' read -r key value; do
        case $key in
            connection) CONNECTION="${CONNECTION:-$value}" ;;
            apps) APPS_FILTER="${APPS_FILTER:-$value}" ;;
        esac
    done <"$CONFIG_FILE"
fi

# --- backend: NetworkManager -------------------------------------------------
nm() { command nmcli "$@"; }

# Conexiones VPN conocidas (vpn = openvpn/fortinet/strongswan…, wireguard aparte).
vpn_connections() {
    nm -t -f NAME,TYPE connection show 2>/dev/null |
        awk -F: '$2 == "vpn" || $2 == "wireguard" { print $1 }'
}

active_vpn() {
    local name
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        if nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
            printf '%s' "$name"
            return 0
        fi
    done < <(vpn_connections)
    return 1
}

resolve_connection() {
    if [[ -n $CONNECTION ]]; then
        printf '%s' "$CONNECTION"
        return 0
    fi
    active_vpn && return 0
    vpn_connections | head -1
}

tunnel_ip() { # tunnel_ip <connection>
    local name=$1 dev
    dev=$(nm -t -f GENERAL.DEVICES connection show "$name" 2>/dev/null | head -1 | cut -d: -f2-)
    [[ -n $dev ]] || return 1
    nm -t -f IP4.ADDRESS device show "$dev" 2>/dev/null | head -1 | cut -d: -f2 | cut -d/ -f1
}

tunnel_gateway() {
    local name=$1 dev
    dev=$(nm -t -f GENERAL.DEVICES connection show "$name" 2>/dev/null | head -1 | cut -d: -f2-)
    [[ -n $dev ]] || return 1
    nm -t -f IP4.GATEWAY device show "$dev" 2>/dev/null | head -1 | cut -d: -f2
}

notify() {
    have notify-send || return 0
    [[ ${WORK_VPN_NOTIFY:-1} == 0 ]] && return 0
    notify-send --app-name="Work connection" --icon=network-vpn "$@" 2>/dev/null || true
}

# --- apps de trabajo ---------------------------------------------------------
# Se detectan por binario o por .desktop; el orden manda en el popup.
# id:clave de la etiqueta:binario:archivo .desktop:icono
KNOWN_APPS=(
    "teams:app-teams:teams-for-linux:teams-for-linux.desktop:󰊻"
    "slack:app-slack:slack:slack.desktop:󰒱"
    "discord:app-discord:discord:discord.desktop:󰙯"
    "signal:app-signal:signal-desktop:signal.desktop:󰭹"
    "remmina:app-remmina:remmina:org.remmina.Remmina.desktop:󰆍"
)

app_label() { # app_label <id> — la etiqueta se traduce como todo lo demás
    msg "$(app_field "$1" 2)"
}

app_field() { # app_field <id> <n>
    local entry
    for entry in "${KNOWN_APPS[@]}"; do
        [[ ${entry%%:*} == "$1" ]] || continue
        printf '%s' "$entry" | cut -d: -f"$2"
        return 0
    done
    return 1
}

desktop_file() { # desktop_file <archivo .desktop>
    local f
    for f in "$HOME/.local/share/applications/$1" "/usr/share/applications/$1" \
        "/var/lib/flatpak/exports/share/applications/$1"; do
        [[ -r $f ]] && {
            printf '%s' "$f"
            return 0
        }
    done
    return 1
}

app_available() { # app_available <id>
    local bin desktop
    bin=$(app_field "$1" 3)
    [[ -n $bin ]] || return 1
    if [[ $bin == /* ]]; then
        [[ -x $bin ]]
        return
    fi
    have "$bin" && return 0
    desktop=$(app_field "$1" 4)
    [[ -n $desktop ]] && desktop_file "$desktop" >/dev/null
}

app_launch() { # app_launch <id>
    local bin desktop file
    bin=$(app_field "$1" 3)
    desktop=$(app_field "$1" 4)
    if have "$bin"; then
        setsid nohup "$bin" >/dev/null 2>&1 &
        return 0
    fi
    if [[ -n $desktop ]] && file=$(desktop_file "$desktop"); then
        if have gtk-launch; then
            gtk-launch "$(basename "$file" .desktop)" >/dev/null 2>&1 &
            return 0
        fi
        if have gio; then
            gio launch "$file" >/dev/null 2>&1 &
            return 0
        fi
    fi
    return 1
}

app_ids() {
    local id
    for entry in "${KNOWN_APPS[@]}"; do
        id=${entry%%:*}
        app_available "$id" || continue
        if [[ -n $APPS_FILTER ]]; then
            case ",$APPS_FILTER," in
                *",$id,"*) ;;
                *) continue ;;
            esac
        fi
        printf '%s\n' "$id"
    done
}

app_open() { # app_open <id>
    local id=$1 bin desktop
    app_available "$id" || die "$(msg app-missing "$id")"
    bin=$(app_field "$id" 3)
    desktop=$(app_field "$id" 4)
    app_launch "$id" || die "$(msg app-failed "$id")"
}

# --- salida ------------------------------------------------------------------
need_jq() { have jq || die "$(msg no-jq)"; }

print_status_json() {
    need_jq
    local name connected="false" ip="" gw="" detail=""
    if name=$(resolve_connection) && [[ -n $name ]]; then
        if nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
            connected="true"
            ip=$(tunnel_ip "$name" || true)
            gw=$(tunnel_gateway "$name" || true)
            detail=$(msg connected)
        else
            detail=$(msg disconnected)
        fi
    else
        detail=$(msg no-connections)
    fi
    jq -nc --arg backend "nmcli" --argjson connected "$connected" \
        --arg name "${name:-}" --arg ip "$ip" --arg gateway "$gw" --arg detail "$detail" \
        '{backend: $backend, connected: $connected, connection: $name, ip: $ip, gateway: $gateway, detail: $detail}'
}

print_status_text() {
    local name
    if name=$(resolve_connection) && [[ -n $name ]] &&
        nm -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$name"; then
        msg vpn-up "$name"
        local ip gw
        ip=$(tunnel_ip "$name" || true)
        gw=$(tunnel_gateway "$name" || true)
        [[ -n $ip ]] && printf 'IP %s\n' "$ip"
        [[ -n $gw ]] && printf 'via %s\n' "$gw"
    else
        msg vpn-off
    fi
}

print_apps_json() {
    need_jq
    local id label icon args
    {
        for id in $(app_ids); do
            label=$(app_label "$id")
            icon=$(app_field "$id" 5)
            jq -nc --arg id "$id" --arg label "$label" --arg icon "$icon" \
                '{id: $id, label: $label, icon: $icon}'
        done
    } | jq -sc '.'
}

usage() {
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
}

# work-vpn lang [en|es] — idioma del widget y del helper. El archivo lo comparte
# el panel (que lo lee al arrancar y lo escribe desde su botoncito), así que esto
# es exactamente lo mismo desde la terminal.
lang_cmd() {
    local want="${1:-}"
    case $want in
        "") printf '%s\n' "$LANG_CODE" ;;
        en | es)
            mkdir -p "$CONFIG_DIR"
            printf '%s\n' "$want" >"$LANG_FILE"
            msg lang-set "$want"
            ;;
        *) die "$(msg lang-usage)" ;;
    esac
}

# --- comandos ----------------------------------------------------------------
cmd=${1:-status}
shift || true
case $cmd in
    status | --status)
        if [[ ${1:-} == --json ]]; then print_status_json; else print_status_text; fi
        ;;
    up | connect | --vpn-only)
        name=$(resolve_connection) || die "$(msg no-vpn-nm)"
        nm connection up "$name" >/dev/null 2>&1 || die "$(msg up-failed "$name")"
        notify "$(msg vpn-on)" "$name"
        msg vpn-up "$name"
        ;;
    down | disconnect | --down)
        name=$(resolve_connection) || die "$(msg no-vpn)"
        nm connection down "$name" >/dev/null 2>&1 || die "$(msg down-failed "$name")"
        notify "$(msg vpn-off)" "$name"
        msg vpn-down "$name"
        ;;
    toggle)
        if name=$(active_vpn); then
            exec "$0" down
        fi
        exec "$0" up
        ;;
    list)
        vpn_connections
        ;;
    lang)
        lang_cmd "${1:-}"
        ;;
    apps)
        if [[ ${1:-} == --json ]]; then print_apps_json; else app_ids; fi
        ;;
    open)
        [[ -n ${1:-} ]] || die "$(msg app-which)"
        app_open "$1"
        ;;
    --rdp) app_open remmina ;;
    --teams) app_open teams ;;
    -h | --help | help) usage ;;
    *) die "$(msg unknown-cmd "$cmd")" ;;
esac
