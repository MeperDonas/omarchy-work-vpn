{
  "schemaVersion": 1,
  "id": "meperdonas.work-vpn",
  "name": "Work connection",
  "version": "1.0.0",
  "author": "Santiago Villabona (MeperDonas)",
  "license": "MIT",
  "description": "VPN, remote desktop and Teams for the workday, in one bar icon: state, tunnel IP and gateway, and the connect/disconnect/RDP/Teams actions.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Work connection",
    "description": "Work VPN status (IP, gateway) with connect, disconnect, RDP and Teams actions, driven by a helper CLI.",
    "category": "System",
    "aliases": ["work", "vpn", "work connection", "rdp"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "helper": "conectar-trabajo",
      "label": "Work connection",
      "refreshIntervalSec": 5,
      "showRemmina": "On",
      "showTeams": "On"
    },
    "schema": [
      {
        "key": "helper",
        "type": "string",
        "label": "Helper command",
        "defaultValue": "conectar-trabajo",
        "description": "CLI that exposes --status / --vpn-only / --down / --rdp / --teams, on PATH or as a full path."
      },
      {
        "key": "label",
        "type": "string",
        "label": "Panel title",
        "defaultValue": "Work connection"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 120,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "showRemmina",
        "type": "enum",
        "label": "Show the remote desktop button",
        "options": ["On", "Off"],
        "defaultValue": "On"
      },
      {
        "key": "showTeams",
        "type": "enum",
        "label": "Show the Teams button",
        "options": ["On", "Off"],
        "defaultValue": "On"
      }
    ]
  }
}
